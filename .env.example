# Copy only the variables required by the features you enable.
# Never commit real tokens, passwords, or database URLs.

# Required for the Discord bot and slash-command deployment
DISCORD_TOKEN=
CLIENT_ID=

# Required for recruitment storage, backup/restore, and PostgreSQL features
DATABASE_URL=

# Optional: use only for guild-scoped slash-command testing
GUILD_ID=

# Optional: browser dashboard (all three are required to enable it)
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_GUILD_ID=

# Optional: Lavalink music. Set these on the bot service.
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_SECURE=false
LAVALINK_SERVER_PASSWORD=

# Railway supplies PORT automatically for the dashboard web server.
# On the separate Lavalink service, LAVALINK_SERVER_PASSWORD must match
# the bot service password. SERVER_PORT defaults to 2333.
