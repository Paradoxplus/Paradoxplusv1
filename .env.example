# Copy only the variables required by the features you enable.
# Never commit real tokens, passwords, or database URLs.

# Required for the Discord bot and slash-command deployment
DISCORD_TOKEN=
CLIENT_ID=

# Required for recruitment storage, backup/restore, and PostgreSQL features
DATABASE_URL=

# Optional: use only for guild-scoped slash-command testing
GUILD_ID=

# Optional: browser dashboard (all three are required to enable it)
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_GUILD_ID=

